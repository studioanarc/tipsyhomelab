/**
 * Bubble Counter MQTT Message Examples
 *
 * These are example JSON payloads for bubble counter sensors.
 * Use these formats when implementing custom bubble counters.
 *
 * Topic: tipsylab/{batch_id}/bubbles
 * QoS: 1 (recommended)
 * Retained: true (recommended)
 */

// ============================================================================
// MINIMAL MESSAGE
// ============================================================================
// Bare minimum required fields
{
  "count": 1,
  "timestamp": 1699999999000
}

// ============================================================================
// STANDARD MESSAGE
// ============================================================================
// Recommended format with calculated bubble rate
{
  "count": 1234,
  "timestamp": 1699999999000,
  "interval": 1250,  // milliseconds since last bubble
  "rate": 48.0  // bubbles per minute
}

// ============================================================================
// DETAILED MESSAGE
// ============================================================================
// Full message with all optional fields
{
  "count": 1234,
  "timestamp": 1699999999000,
  "interval": 1250,
  "rate": 48.0,
  "sensor_id": "bubble_counter_1",
  "raw_value": 523,  // Optional: raw sensor reading
  "threshold": 512,  // Optional: detection threshold
  "wifi_rssi": -65,  // Optional: WiFi signal strength (dBm)
  "uptime": 3600000  // Optional: sensor uptime in milliseconds
}

// ============================================================================
// MULTIPLE BUBBLE EVENT
// ============================================================================
// If sensor batches multiple bubbles
{
  "count": 1237,
  "timestamp": 1699999999000,
  "bubbles": [
    {"timestamp": 1699999997000, "interval": 1100},
    {"timestamp": 1699999998200, "interval": 1200},
    {"timestamp": 1699999999000, "interval": 800}
  ],
  "rate": 52.3
}

// ============================================================================
// ERROR CONDITION
// ============================================================================
// Report sensor errors
{
  "count": 1234,
  "timestamp": 1699999999000,
  "error": true,
  "error_code": "SENSOR_UNRELIABLE",
  "error_message": "Ambient light too high",
  "raw_value": 950  // Out of expected range
}

// ============================================================================
// CALIBRATION MODE
// ============================================================================
// Special message during calibration
{
  "count": 0,
  "timestamp": 1699999999000,
  "calibration_mode": true,
  "baseline": 500,  // Baseline reading (no bubble)
  "bubble_reading": 300,  // Reading with bubble
  "threshold": 400  // Calculated threshold
}

// ============================================================================
// HISTORICAL BATCH
// ============================================================================
// Send multiple historical readings (if sensor was offline)
{
  "sensor_id": "bubble_counter_1",
  "batch": [
    {"count": 1230, "timestamp": 1699999990000, "rate": 45.0},
    {"count": 1231, "timestamp": 1699999995000, "rate": 46.0},
    {"count": 1232, "timestamp": 1699999998000, "rate": 47.0},
    {"count": 1233, "timestamp": 1699999999000, "rate": 48.0}
  ]
}

// ============================================================================
// PUBLISHING EXAMPLES
// ============================================================================

