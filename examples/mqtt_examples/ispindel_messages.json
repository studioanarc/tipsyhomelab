// SIMULATING iSPINDEL FOR TESTING
// ============================================================================
/**
 * Python script to simulate iSpindel messages
 */
/*
import paho.mqtt.client as mqtt
import json
import time
import random

client = mqtt.Client()
client.username_pw_set("tipsylab", "password")
client.connect("localhost", 1883)

def simulate_ispindel(day):
    # Simulate fermentation progress
    gravity_curve = {
        0: 1.055,
        1: 1.054,
        3: 1.038,
        5: 1.022,
        7: 1.010,
        10: 1.002,
        14: 1.000
    }

    # Interpolate gravity
    gravity = 1.055 - (day / 14) * 0.055
    gravity = max(1.000, gravity)

    # Calculate angle (reverse polynomial - approximate)
    angle = 25 + (70 * (1.055 - gravity) / 0.055)

    # Battery drain
    battery = 4.15 - (day * 0.027)  # ~4 weeks battery life

    # Temperature variation
    temp = 20.0 + random.uniform(-1, 2)

    message = {
        "name": "iSpindel01",
        "ID": 123456,
        "angle": round(angle, 1),
        "temperature": round(temp, 1),
        "temp_units": "C",
        "battery": round(battery, 2),
        "gravity": round(gravity, 3),
        "interval": 900,
        "RSSI": random.randint(-75, -55)
    }

    client.publish(
        "ispindel/test",
        json.dumps(message),
        qos=1,
        retain=True
    )

    print(f"Day {day}: {message}")

# Simulate 14 days of fermentation
for day in range(15):
    simulate_ispindel(day)
    time.sleep(2)  # Publish every 2 seconds (sped up for testing)
*/

// ============================================================================
// TROUBLESHOOTING
// ============================================================================
/*
Common Issues:

1. No messages received:
   - Check iSpindel is connected to WiFi (LED blinking)
   - Verify MQTT broker address in iSpindel config
   - Check MQTT credentials
   - Verify topic name matches configuration

2. Wrong gravity readings:
   - Calibration coefficients incorrect
   - iSpindel stuck to fermenter wall
   - Not floating properly (check weight)
   - Temperature affecting calibration

3. Frequent disconnects:
   - Weak WiFi signal (RSSI < -75 dBm)
   - Increase sleep interval to conserve battery
   - Check broker connection limits
   - Verify MQTT keep-alive settings

4. Battery draining fast:
   - WiFi connection issues (constantly retrying)
   - Sleep interval too short (< 600 seconds)
   - Old battery (replace after 1-2 years)
   - Temperature too low (< 10°C)

5. Inaccurate temperature:
   - DS18B20 not in good contact with wort
   - Temperature sensor damaged
   - Need temperature calibration offset

Testing:
1. Subscribe to iSpindel topic:
   mosquitto_sub -h localhost -u user -P pass -t 'ispindel/#' -v

2. Verify messages arriving every 15 minutes (or your interval)

3. Check values make sense:
   - Angle: 25-85 degrees typical
   - Gravity: 1.000-1.100 typical
   - Battery: 3.5-4.2V
   - Temperature: 10-30°C typical
   - RSSI: Better than -80 dBm

4. Monitor in Home Assistant entity
*/
