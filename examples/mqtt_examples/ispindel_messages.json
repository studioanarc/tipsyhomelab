/**
 * iSpindel MQTT Message Examples
 *
 * iSpindel publishes comprehensive fermentation data including
 * gravity, temperature, battery status, and WiFi signal.
 *
 * Topic: ispindel/{device_name} or custom topic
 * QoS: 0 or 1
 * Retained: true (recommended)
 */

// ============================================================================
// STANDARD iSPINDEL MESSAGE
// ============================================================================
// This is the standard message format from iSpindel firmware
{
  "name": "iSpindel01",
  "ID": 123456,
  "angle": 45.3,
  "temperature": 20.5,
  "temp_units": "C",
  "battery": 3.95,
  "gravity": 1.042,
  "interval": 900,
  "RSSI": -65
}

// ============================================================================
// FIELD DESCRIPTIONS
// ============================================================================
{
  "name": "iSpindel01",  // Device name (set in iSpindel config)
  "ID": 123456,  // Unique device ID (ESP chip ID)
  "angle": 45.3,  // Tilt angle in degrees (25-85 typical range)
  "temperature": 20.5,  // Temperature in Celsius or Fahrenheit
  "temp_units": "C",  // "C" for Celsius, "F" for Fahrenheit
  "battery": 3.95,  // Battery voltage (3.5-4.2V typical for Li-ion)
  "gravity": 1.042,  // Specific gravity (calculated from angle using polynomial)
  "interval": 900,  // Sleep interval in seconds (900 = 15 minutes)
  "RSSI": -65  // WiFi signal strength in dBm (better than -70)
}

// ============================================================================
// RAW ANGLE MESSAGE (No Calibration)
// ============================================================================
// If you haven't calibrated iSpindel yet, it may only send angle
{
  "name": "iSpindel01",
  "ID": 123456,
  "angle": 45.3,
  "temperature": 20.5,
  "temp_units": "C",
  "battery": 4.05,
  "interval": 900,
  "RSSI": -58
}
// TipsyHomeLab will calculate gravity from angle using your calibration polynomial

// ============================================================================
// BATTERY WARNING EXAMPLE
// ============================================================================
// Battery getting low
{
  "name": "iSpindel01",
  "ID": 123456,
  "angle": 42.1,
  "temperature": 19.8,
  "temp_units": "C",
  "battery": 3.65,  // Low battery (< 3.7V)
  "gravity": 1.018,
  "interval": 900,
  "RSSI": -72  // Weak signal (< -70 dBm)
}

// ============================================================================
// CRITICAL BATTERY EXAMPLE
// ============================================================================
// Battery critically low
{
  "name": "iSpindel01",
  "ID": 123456,
  "angle": 41.8,
  "temperature": 19.6,
  "temp_units": "C",
  "battery": 3.48,  // Critical (< 3.5V) - will shut down soon
  "gravity": 1.016,
  "interval": 900,
  "RSSI": -68
}

// ============================================================================
// FAHRENHEIT TEMPERATURE
